% Untyped translation. TODO: can/should we make use of typing information?

% Translate from the clairvoyance monad to a demand function.
pred translateD i:term o:term.
translateD M M' :- translate_head [] M M'.

% Translate from the clairvoyance monad to the partiality monad (option).
% It's just a renaming of functions because they have the same interface.
% Another way we could do this is to parameterize definitions by a type class
% so it can be specialized to both the clairvoyance monad and the option monad.
% Or just get rid of the clairvoyance monad. We currently use the clairvoyance
% monad to have a connection to an already formalized operational semantics,
% but we could formalize a connection between demand functions and an operational
% semantics directly.
pred translateP i:term o:term.
translateP {{ Core.ret lp:M }} {{ Partial.ret lp:M'}} :- translateP M M'.
translateP {{ Core.bind lp:M lp:N }} {{ Partial.bind lp:M' lp:N' }} :- translateP M M', translateP N N'.
translateP {{ Core.force lp:M }} {{ Partial.force lp:M' }} :- translateP M M'.
translateP {{ Core.thunk lp:M }} {{ Partial.thunk lp:M' }} :- translateP M M'.
translateP {{ Core.tick }} {{ Partial.tick }}.
% other Coq constructs
translateP {{ fun x : lp:A => lp:(M x) }} {{ fun x : lp:A' => lp:(M' x) }} :- translateP A A', pi x\ translateP x x => translateP (M x) (M' x).
translateP {{ let x := lp:M in lp:(N x) }} {{ let x := lp:M' in lp:(N' x) }} :- translateP M M', pi x\ translateP x x => translateP (N x) (N' x).
translateP (app Ms) (app Ms') :- std.map Ms translateP Ms'.
translateP (match M R Bs) (match M' R' Bs') :- translateP M M', translateP R R', std.map Bs translateP Bs'.
% type translation
translateP {{ forall x : lp:A, lp:(B x) }} {{ forall x : lp:A', lp:(B' x) }} :- translateP A A', pi x\ translateP x x => translateP (B x) (B' x).
translateP {{ Core.M }} {{ option }}.
translateP {{ Core.T }} {{ Core.T }}.
% TODO: put these in a Db
translateP {{ listA }} {{ listA }}.
translateP {{ @ConsA }} {{ @ConsA }}.
translateP {{ @NilA }} {{ @NilA }}.
translateP {{ unit }} {{ unit }}.
translateP {{ tt }} {{ tt }}.
translateP {{ nat }} {{ nat }}.
translateP {{ S }} {{ S }}.
translateP {{ O }} {{ O }}.
translateP M M' :- std.fatal-error-w-data "No match:" M.

pred def_of i:string o:term o:term.
def_of IDENT M A :-
  coq.locate IDENT CID,
  CID = const ID,
  coq.env.const ID (some M) A.


pred translate_const i:string o:term.

translate_const IDENT R :-
  def_of IDENT M _,
  translate M R.


typeabbrev v term.  % terms that should be variables
typeabbrev indemand (list (prod v term)).
typeabbrev leaf (term -> term -> prop).

% The first argument is the list of free variables.
pred translate_head i:(list v) i:term o:term.

% The first argument contains a continuation that expects the demand on the free variables.
pred translate_body i:v i:(indemand -> term -> prop) i:term o:term.
pred translate_value i:(indemand -> term -> prop) i:v i:term o:term.



translate_head Vs (fun X A M) (fun X A M') :- !,
  pi x\
    (pi D K R\ (translate_value K D x R :- !, K (pair x D :: []) R)) =>
    translate_head (x :: Vs) (M x) (M' x).
translate_head Vs M (fun `d` _ M') :-
  not (var M),
  pi d\ translate_body d (ret_tuple Vs) M (M' d).

pred ret_tuple i:(list v) i:indemand o:term.
ret_tuple Vs F {{ OTick.ret lp:R }} :- build_tuple Vs F R.

pred build_tuple i:(list v) i:indemand o:term.
build_tuple [] _ {{ tt }}.
build_tuple [V] F R :- !, lookup_indemand V F R.
build_tuple [V|Vs] F {{ pair lp:R lp:M }} :- lookup_indemand V F M, build_tuple Vs F R.

% build_product [A,B,C] {{ (C * B * A)%type }}
pred build_product i:(list term) o:term.
build_product [] {{ unit }}.
build_product [A] A :- !.
build_product (A :: As) {{ (lp:B * lp:A)%type }} :- build_product As B.

pred lookup_indemand_aux i:v i:indemand i:(option term) o:term.
lookup_indemand_aux V [] none {{ bottom_of lp:V }}.
lookup_indemand_aux V [] (some M) M.
lookup_indemand_aux V (pair V M :: Dem) none R :- !, lookup_indemand_aux V Dem (some M) R.
lookup_indemand_aux V (pair V M :: Dem) (some N) R :- !, lookup_indemand_aux V Dem (some {{ lub lp:M lp:N }}) R.
lookup_indemand_aux V (pair W M :: Dem) Acc R :- not (V = W), lookup_indemand_aux V Dem Acc R.

pred lookup_indemand i:v i:indemand o:term.
lookup_indemand V Dem M :- lookup_indemand_aux V Dem none M.

pred lub_indemand i:indemand i:indemand o:indemand.
lub_indemand E1 E2 R :- std.append E1 E2 R.

translate_body D K {{ Core.ret lp:M }} N' :- !,
  translate_value K D M N'.
% match should be on a variable
translate_body D K (match V {{fun x : listA _ => _}} [N_nil, N_cons])
                   (match V {{fun x : listA _ => _}} [N_nil', N_cons']) :- !,
  translate_body D K N_nil N_nil',
  translate_branch D K V (Es\ M\ M = {{ ConsA }}) N_cons N_cons'.
% force should be on a variable
translate_body D K {{ force lp:V }} {{ let+ d := forceD lp:V lp:D in lp:(M' d) }} :- !,
  pi d\ K (pair V d :: []) (M' d).
translate_body D K {{ let! x := lp:M in lp:(N x) }} MN' :- std.fatal-error-w-data "TODO: let " M.
translate_body D K M R :- std.fatal-error-w-data "No match:" M.


translate_value K D {{ NilA }} M' :- K [] M'.
translate_value K D {{ ConsA lp:M0 lp:M1 }}
  {{ (let+ (d0, d1) := unConsA lp:D in lp:(M01 d0 d1))%otick }}
  :- !,
  pi d0 d1\
    sigma K0\ K0 = (Es0\ M1'\
      sigma K1\ K1 = (Es1\ R\ sigma TMP\ lub_indemand Es0 Es1 TMP, K TMP R),
      translate_value K1 d1 M1 M1'),
    translate_value K0 d0 M0 (M01 d0 d1).

pred translate_branch i:(term -> (term -> term) -> term -> prop) i:(indemand -> term -> prop) i:v i:(indemand -> term -> prop) i:term o:term.
translate_branch Ret K V H (fun X A M) (fun X A M') :- !,
  pi x\
    translate_branch Ret K V (translate_branch_accum x H) (M x) (M' x).
translate_branch Ret K V H M M' :-
  K' = (Es\ M\ sigma N\ H Es N, K (pair V N :: Es) M),
  translate_body Ret K' M M'.

pred translate_branch_accum i:v i:(indemand -> term -> prop) i:indemand o:term.
translate_branch_accum V H Es M :-
  H Es M1, lookup_indemand V Es M2, M = app [M1, M2].

pred translate_type i:term o:term.
translate_type T T' :- translate_type.aux [] T T'.
translate_type.aux As (prod X A T) (prod X A T') :-
  pi x\ translate_type.aux (A :: As) (T x) (T' x).
translate_type.aux As {{ M lp:T }} {{ (lp:T -> OTick lp:R) }} :-
  build_product As R.


pred translate_name i:string i:string o:string.
translate_name SUFFIX NAMEM NAMED :-
  S is NAMEM,
  N is size S,
  ( ("M" is substring NAMEM (N - 1) 1, !, NAMED is substring NAMEM 0 (N - 1) ^ SUFFIX)
  ; NAMED is NAMEM ^ SUFFIX).


pred main i:(list argument).
main [str IDENT] :- !,
  def_of IDENT M A, !,
  translateP M MP, !,
  translateP A AP, !,
  coq.say "translateP done",
  translateD M MD, !,
  translate_type A AD, !,
  % coq.say "Preterm: " M MD,
  % coq.say "Translated term: " {coq.pp->string {coq.term->pp MD} } MD,
  std.assert-ok! (coq.elaborate-skeleton MP AP MP') "Result is ill-typed!",
  std.assert-ok! (coq.elaborate-skeleton MD AD MD') "Result is ill-typed!",
  coq.env.fresh-global-id {translate_name "P" IDENT} IDENTP,
  coq.env.fresh-global-id {translate_name "D" IDENT} IDENTD,
  coq.env.add-const IDENTP MP' _ _ _,
  coq.env.add-const IDENTD MD' _ _ _.
main [str IDENT, str "debug"] :-
  def_of IDENT M _,
  translate M M',
  coq.say M'.
main [trm M] :-
  translate M M',
  coq.say "Translated:" M'.
main ARGS :- coq.say "Translation failed. Arguments:" ARGS.
